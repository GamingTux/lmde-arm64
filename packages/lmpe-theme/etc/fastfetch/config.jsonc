{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "linuxmint",
        "color": {
            "1": "green"
        },
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "custom",
            "key": "Distro  ",
            "format": "LMPE [Codename: Tatooine]"
        },
        {
            "type": "custom",
            "key": "Base    ",
            "format": "LMDE 7 • Debian Trixie • Raspberry Pi OS"
        },
        {
            "type": "host",
            "key": "Host    "
        },
        {
            "type": "kernel",
            "key": "Kernel  "
        },
        {
            "type": "uptime",
            "key": "Uptime  "
        },
        {
            "type": "cpu",
            "key": "CPU     ",
            "format": "{1} ({3}) @ {7}"
        },
        {
            "type": "cpu",
            "key": "CPU Temp",
            "format": "{8}",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "GPU     "
        },
        {
            "type": "memory",
            "key": "RAM     "
        },
        {
            "type": "swap",
            "key": "ZRAM    "
        },
        {
            "type": "disk",
            "key": "Disk (/)",
            "folders": "/"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        "break",
        "colors"
    ]
}
