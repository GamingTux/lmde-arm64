#!/bin/bash
set -e

THEMES_DIR="/usr/share/plymouth/themes/lmpe/backgrounds"
WALLPAPER_DIR="/usr/share/backgrounds/lmpe"
PLYMOUTH_BG="/usr/share/plymouth/themes/lmpe/background.png"
WALLPAPER_DEF="/usr/share/backgrounds/lmpe/default.png"

show_help() {
    echo "LMPE Theme & Artwork Switcher"
    echo "Usage: sudo lmpe-theme <theme-name>"
    echo "       lmpe-theme list"
    echo "       lmpe-theme current"
    echo ""
    echo "Available themes:"
    for f in "$THEMES_DIR"/*.png; do
        [ -f "$f" ] && echo "  - $(basename "$f" .png)"
    done
}

case "${1:-}" in
    list)
        echo "Available LMPE Themes:"
        for f in "$THEMES_DIR"/*.png; do
            [ -f "$f" ] && echo "  * $(basename "$f" .png)"
        done
        exit 0
        ;;
    current)
        if [ -L "$PLYMOUTH_BG" ]; then
            TARGET=$(readlink -f "$PLYMOUTH_BG")
            echo "Current Bootscreen Theme: $(basename "$TARGET" .png)"
        else
            echo "Current Bootscreen Theme: Custom file"
        fi
        if [ -L "$WALLPAPER_DEF" ]; then
            WPTARGET=$(readlink -f "$WALLPAPER_DEF")
            echo "Current Default Wallpaper: $(basename "$WPTARGET" .png)"
        fi
        exit 0
        ;;
    "")
        show_help
        exit 1
        ;;
    *)
        THEME="$1"
        if [ "$EUID" -ne 0 ]; then
            echo "Error: Please run with sudo (e.g. sudo lmpe-theme $THEME)" >&2
            exit 1
        fi
        if [ ! -f "$THEMES_DIR/${THEME}.png" ]; then
            echo "Error: Theme '${THEME}' not found in $THEMES_DIR." >&2
            echo "Available themes: $(ls -1 "$THEMES_DIR" | sed 's/\.png$//' | tr '\n' ' ')" >&2
            exit 1
        fi

        echo ">>> Switching LMPE bootscreen to '${THEME}'..."
        ln -sf "backgrounds/${THEME}.png" "$PLYMOUTH_BG"
        
        if [ -f "$WALLPAPER_DIR/${THEME}.png" ]; then
            ln -sf "${THEME}.png" "$WALLPAPER_DEF"
            echo ">>> System default wallpaper updated to '${THEME}'."
            echo "    (Note: Any customized personal wallpaper set in Cinnamon remains untouched)."
        fi

        echo ">>> Updating initramfs (baking new bootscreen into boot image)..."
        update-initramfs -u
        echo ">>> Success! Bootscreen and default artwork set to '${THEME}'."
        ;;
esac
